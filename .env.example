DATABASE_URL=postgres://golf:golf@localhost:5432/golf
TEST_DATABASE_URL=postgres://golf:golf@localhost:5432/golf_test
PORT=3000

# Production (see docs/PILOT.md)
# Long random string; encrypts the booking provider's sign-in details.
SYNC_SECRET=
# The public address of the server, used to verify card processor webhooks.
PUBLIC_URL=
# Lets the help assistant answer with Claude; without it, answers come from the guides.
ANTHROPIC_API_KEY=
SUPPORT_EMAIL=
# Folder holding the staff app's web build; when set, the server also serves the app.
STAFF_WEB_DIR=
POSTGRES_PASSWORD=
